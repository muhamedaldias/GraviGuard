{
  "name": "graviguard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GraviGuard Simulation Platform — synthetic-data interactive simulation of dynamic NPSHa lift for centrifugal pumps",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "scenarios": "vite-node scripts/run-scenarios.ts",
    "scenarios:generate": "vite-node scripts/generate-scenarios.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.1.0",
    "i18next": "^23.15.0",
    "katex": "^0.18.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.0",
    "uplot": "^1.6.31",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.6",
    "vite-node": "^3.2.4",
    "vitest": "^4.1.12"
  }
}