{
  "name": "gurve",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GraviGuard Simulation Platform — synthetic-data interactive simulation of dynamic NPSHa lift for centrifugal pumps",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "scenarios": "vite-node scripts/run-scenarios.ts",
    "scenarios:generate": "vite-node scripts/generate-scenarios.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.1.0",
    "i18next": "^23.15.0",
    "katex": "^0.16.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.0",
    "uplot": "^1.6.31",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.3",
    "vite": "^5.4.10",
    "vite-node": "^2.1.4",
    "vitest": "^2.1.4"
  }
}
